<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dozycoffee.infrastructure.persistance.mapper.ProductQueryMapper">

    <resultMap id="productWithCategoryRow" type="com.dozycoffee.infrastructure.persistance.entity.ProductWithCategoryRow">
        <constructor>
            <idArg name="productId"    column="product_id"    javaType="String"/>
            <arg   name="name"         column="name"          javaType="String"/>
            <arg   name="description"  column="description"   javaType="String"/>
            <arg   name="imageUrl"     column="image_url"     javaType="String"/>
            <arg   name="categoryId"   column="category_id"   javaType="String"/>
            <arg   name="categoryName" column="category_name" javaType="String"/>
            <arg   name="price"        column="price"         javaType="int"/>
            <arg   name="kcal"         column="kcal"          javaType="java.lang.Integer"/>
            <arg   name="allergenInfo" column="allergen_info" javaType="String"/>
            <arg   name="kind"         column="kind"          javaType="String"/>
            <arg   name="branchId"     column="branch_id"     javaType="String"/>
            <arg   name="status"       column="status"        javaType="String"/>
            <arg   name="createdAt"    column="created_at"    javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="productTagNameRow" type="com.dozycoffee.infrastructure.persistance.entity.ProductTagNameRow">
        <constructor>
            <arg name="productId" column="product_id" javaType="String"/>
            <arg name="tagId"     column="tag_id"     javaType="String"/>
            <arg name="tagName"   column="tag_name"   javaType="String"/>
        </constructor>
    </resultMap>

    <resultMap id="productOptionGroupItemRow" type="com.dozycoffee.infrastructure.persistance.entity.ProductOptionGroupItemRow">
        <constructor>
            <arg name="productId"       column="product_id"      javaType="String"/>
            <arg name="optionGroupId"   column="option_group_id" javaType="String"/>
            <arg name="groupName"       column="group_name"      javaType="String"/>
            <arg name="groupDescription" column="group_description" javaType="String"/>
            <arg name="isRequired"      column="is_required"     javaType="boolean"/>
            <arg name="allowMultiple"   column="allow_multiple"  javaType="boolean"/>
            <arg name="itemName"        column="item_name"       javaType="String"/>
            <arg name="itemDescription" column="item_description" javaType="String"/>
            <arg name="itemPrice"       column="item_price"      javaType="int"/>
            <arg name="itemCreatedAt"   column="item_created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <select id="findByFilter" resultMap="productWithCategoryRow">
        SELECT BIN_TO_UUID(p.product_id) AS product_id,
               p.name, p.description, p.image_url,
               BIN_TO_UUID(p.category_id) AS category_id,
               c.name AS category_name,
               p.price, p.kcal, p.allergen_info, p.kind,
               BIN_TO_UUID(p.branch_id) AS branch_id,
               p.status, p.created_at
        FROM product p
        LEFT JOIN category c ON p.category_id = c.category_id
        <where>
            <if test="name.present">
                AND p.name LIKE CONCAT('%', #{name.get}, '%')
            </if>
            <if test="categoryId.present">
                AND p.category_id = UUID_TO_BIN(#{categoryId.get.value})
            </if>
            <if test="!tagIds.isEmpty()">
                AND EXISTS (
                    SELECT 1 FROM product_tag pt
                    WHERE pt.product_id = p.product_id
                    AND pt.tag_id IN
                    <foreach item="tagId" collection="tagIds" open="(" separator="," close=")">
                        UUID_TO_BIN(#{tagId.value})
                    </foreach>
                )
            </if>
            <if test="optionGroupId.present">
                AND EXISTS (
                    SELECT 1 FROM product_option_group pog
                    WHERE pog.product_id = p.product_id
                    AND pog.option_group_id = UUID_TO_BIN(#{optionGroupId.get.value})
                )
            </if>
            <if test="!statuses.isEmpty()">
                AND p.status IN
                <foreach item="s" collection="statuses" open="(" separator="," close=")">
                    #{s.name()}
                </foreach>
            </if>
            <if test="!kinds.isEmpty()">
                AND p.kind IN
                <foreach item="k" collection="kinds" open="(" separator="," close=")">
                    #{k.name()}
                </foreach>
            </if>
            <if test="branchId.present">
                AND p.branch_id = UUID_TO_BIN(#{branchId.get.value})
            </if>
        </where>
    </select>

    <select id="findTagsByProductIds" resultMap="productTagNameRow">
        SELECT BIN_TO_UUID(pt.product_id) AS product_id,
               BIN_TO_UUID(t.tag_id) AS tag_id,
               t.name AS tag_name
        FROM product_tag pt
        JOIN tag t ON pt.tag_id = t.tag_id
        WHERE pt.product_id IN
        <foreach item="id" collection="productIds" open="(" separator="," close=")">
            UUID_TO_BIN(#{id})
        </foreach>
    </select>

    <select id="findOptionGroupsByProductIds" resultMap="productOptionGroupItemRow">
        SELECT BIN_TO_UUID(pog.product_id) AS product_id,
               BIN_TO_UUID(og.option_group_id) AS option_group_id,
               og.name AS group_name,
               og.description AS group_description,
               pog.is_required,
               pog.allow_multiple,
               oi.name AS item_name,
               oi.description AS item_description,
               oi.price AS item_price,
               oi.created_at AS item_created_at
        FROM product_option_group pog
        JOIN option_group og ON pog.option_group_id = og.option_group_id
        JOIN option_item oi ON og.option_group_id = oi.option_group_id
        WHERE pog.product_id IN
        <foreach item="id" collection="productIds" open="(" separator="," close=")">
            UUID_TO_BIN(#{id})
        </foreach>
    </select>

</mapper>
